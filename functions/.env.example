# Copy to functions/.env.<your-project-id> or use `firebase functions:secrets:set`.
# NEVER commit real values. Stripe must be TEST mode only.
STRIPE_MODE=test
# Put these in Secret Manager (recommended):
#   firebase functions:secrets:set STRIPE_SECRET_KEY      -> sk_test_...
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET  -> whsec_... (from the TEST webhook endpoint)
#   firebase functions:secrets:set ANTHROPIC_API_KEY      -> your AI provider key
STRIPE_CURRENCY=inr
AI_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT_PER_HOUR=30
