# ===== Book Swap Hub: example configuration (copy values, never commit real ones) =====
# Flutter app (PUBLIC values only), passed with --dart-define, NOT read from a file:
#   flutter run --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_xxx
#   flutter run --dart-define=USE_EMULATORS=true --dart-define=EMULATOR_HOST=10.0.2.2
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
USE_EMULATORS=false

# Cloud Functions (SECRET values live in Secret Manager, see docs/API_SETUP.md):
#   firebase functions:secrets:set STRIPE_SECRET_KEY       (sk_test_... only)
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET   (whsec_... from the TEST endpoint)
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Non-secret settings (functions/.env.<project-id>):
STRIPE_MODE=test
STRIPE_CURRENCY=inr
AI_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT_PER_HOUR=30
REQUIRE_VERIFIED_EMAIL=true

# RULES: only pk_test_ / sk_test_ keys are ever accepted. Live keys are rejected by the app AND the server.
